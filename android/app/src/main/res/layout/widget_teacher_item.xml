<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/widget_teacher_item.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/widget_card_background"
    android:layout_marginBottom="5dp">

    <ImageView
        android:id="@+id/teacher_item_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/circle_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="9dp">

        <TextView
            android:id="@+id/teacher_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ms. Smith"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_primary_text"
            android:maxLines="2"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="12sp" />

        <TextView
            android:id="@+id/teacher_item_dept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mathematics"
            android:textSize="9sp"
            android:textColor="@color/widget_secondary_text"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="9sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/teacher_item_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Present"
        android:textSize="8sp"
        android:textStyle="bold"
        android:textColor="@color/gr0ve_green"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/status_pill_background"
        android:maxLines="2"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="6sp"
        android:autoSizeMaxTextSize="8sp" />

</LinearLayout>
