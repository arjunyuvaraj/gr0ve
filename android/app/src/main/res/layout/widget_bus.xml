<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/widget_bus.xml -->
<LinearLayout
    android:id="@+id/widget_root"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@android:drawable/ic_menu_directions"
            android:tint="@color/widget_secondary_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="BUSES"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="@color/widget_secondary_text" />

    </LinearLayout>

    <!-- Empty state (shown when no buses starred) -->
    <TextView
        android:id="@+id/bus_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Star buses in gr0ve"
        android:textSize="12sp"
        android:textColor="@color/widget_secondary_text"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Scrollable list -->
    <LinearLayout
        android:id="@+id/bus_items"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" />

</LinearLayout>
