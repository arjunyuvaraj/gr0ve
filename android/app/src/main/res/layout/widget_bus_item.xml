<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/widget_bus_item.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/widget_card_background"
    android:layout_marginBottom="5dp">

    <TextView
        android:id="@+id/bus_item_code"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:text="57"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/gr0ve_amber"
        android:fontFamily="sans-serif-condensed"
        android:gravity="center" />

    <TextView
        android:id="@+id/bus_item_town"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Hackensack"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/widget_primary_text"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="8dp" />

    <TextView
        android:id="@+id/bus_item_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="On Time"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="@color/gr0ve_green"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/status_pill_background" />

</LinearLayout>